/>\n<span class =\"strong\">Sally</span>: Sure \u2026 Oh No!<br />\n<span class =\"strong\">Vanessa</span>: Sally, maybe you should stay out of the kitchen that is after you help me clean up this mess!<br />\n<span class =\"strong\">Sally</span>: I'm sorry, Vanessa.", "time": "48800"}], "coverimg": "engenn6le03ob08re2img09.jpg"}, "type": "slideshow"}], "template_override": 1, "_data": [], "type": "audio", "title": ""}, {"id": 3, "contents": [{"value": {"images": [{"image": "", "id": 0, "text": "", "time": "0"}, {"image": "", "id": 1, "text": "Quantifiers", "time": "5000"}, {"image": "", "id": 2, "text": "<span class=\"bullet\">Use quantifiers with countable and uncountable nouns.</span>", "time": "21000"}, {"image": "", "id": 3, "text": "<span class=\"bullet\">Use these quantifiers with countable nouns.</span>", "time": "42000"}], "video_src": "engenn6le03ob08re3vid01"}, "type": "video"}], "template_override": 1, "_data": [], "type": "video", "title": ""}], "id": 0, "type": "scholar", "_data": [{"type": "lab_options", "contents": [{"content": true, "type": "has_nav"}, {"content": true, "type": "has_exercise_controls"}]}]}]}