": "", "id": 17, "_data": [{"content": "their", "type": "text"}], "selected": 0, "correct": 0}, {"text": "", "id": 18, "_data": [{"content": "cereal.", "type": "text"}], "selected": 0, "correct": 0}], "_data": [{"type": "question", "contents": [{"content": "", "type": "text"}]}, {"content": "secondary_8", "type": "objective"}], "id": 0}], "type": "SLS", "id": 10, "stimuli_ids": []}, {"template_override": 1, "_data": [{"type": "instructions", "contents": []}, {"type": "group", "contents": [{"content": "Quiz", "type": "group_name"}]}, {"content": {"allowed_attempts": 2, "incorrect_feedback": [{"content": "Whoops! Something important is missing.", "type": "text"}, {"content": "Maybe next time...", "type": "text"}], "correct_feedback": "Correct!", "attempt_feedback": [{"content": "", "type": "text"}, {"content": "", "type": "text"}]}, "type": "feedback"}], "questions": [{"responses": [{"id": 0, "_data": [{"content": "", "type": "text"}], "selected": 0, "correct": 0}, {"id": 1, "_data": [{"content": "", "type": "text"}], "selected": 0, "correct": 1}], "_data": [{"type": "question", "contents": [{"content": "", "type": "text"}]}], "id": 0}], "type": "RSLT", "id": 11, "stimuli_ids": []}], "type": "scholar", "_data": [{"type": "lab_options", "contents": [{"content": true, "type": "has_nav"}, {"content": true, "type": "has_exercise_controls"}]}], "id": 0}], "_data": [{"type": "metadata", "contents": [{"content": "Dinner for Four", "type": "lesson_name"}, {"content": "Chewing the Fat", "type": "unit_name"}, {"content": 9, "type": "position"}, {"content": "stub", "type": "origin"}, {"content": 3, "type": "lesson"}, {"content": "B1.1", "type": "level"}]}, {"type": "achievment_test", "contents": [{"content": "false", "type": "test"}]}, {"type": "objectives", "contents": [{"content": " Describe routines and regular activities in a wider range of social contexts.", "type": "primary"}, {"content": " Understands important and some specific information and aspects of attitude and intention using a range of appropriate language, in written or spoken documents or presentations.", "type": "secondary_1"}, {"content": " Understands important and some specific information and aspects of attitude and intention using a range of appropriate language, in written or spoken documents or presentations.", "type": "secondary_2"}, {"content": " Understands important and some specific information and aspects of attitude and intention using a range of appropriate language, in written or spoken documents or presentations.", "type": "secondary_3"}, {"content": " Understands important and some specific information and aspects of attitude and intention using a range of appropriate language, in written or spoken documents or presentations.", "type": "secondary_4"}, {"content": " Understands important and some specific information and aspects of attitude and intention using a range of appropriate language, in written or spoken documents or presentations.", "type": "secondary_5"}, {"content": " Understands important and some specific information and aspects of attitude and intention using a range of appropriate language, in written or spoken documents or presentations.", "type": "secondary_6"}, {"content": " Understands important and some specific information and aspects of attitude and intention using a range of appropriate language, in written or spoken documents or presentations.", "type": "secondary_7"}, {"content": " Understands important and some specific information and aspects of attitude and intention using a range of appropriate language, in written or spoken documents or presentations.", "type": "secondary_8"}]}, {"content": "engenn6le03ob09re1img01.jpg", "type": "background_image"}, {"type": "learning_points", "contents": [{"content": " How much did you use to have?", "type": "heading"}, {"content": " \u201cUsed to\u201d and \u201cwould\u201d express an action that occurred regularly in the past.", "type": "describer"}, {"content": "We use <span class=\"italic\">used to do </span>to talk about the past. It is not a tense but it is like a tense. We use <span class=\"italic\">used to do</span> for the past only.<br /><br /> We use<span class=\"italic\"> would </span>to describe the pattern of action in the past.", "type": "text"}, {"content": "{\"rows\":4,\"columns\":3,\"cells\":[\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"Past Pattern with used to\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"Past Pattern with would\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\" Present\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"I used to drink coffee only occasionally.\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"I would go through about a pound of coffee a month.\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"Now I go through about a pound of coffee a week.\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"I used to have about 5 cups of latte a day.\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"I would go back to the cafe regularly.\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\" Now I only go twice a day.\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\" I used to live on a tight budget.\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\" Back in college, I would save money by making my own coffee.\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\" I still make my own coffee every morning.\\\"}\"],\"styles\":\" intro_table_border instruction_table_background\"}", "type": "table"}]}, {"type": "learning_points", "contents": [{"content": " Expressing Necessity", "type": "heading"}, {"content": "\u201cHave got to\u201d is used to express necessity.<br />\u201cGoing to have to\u201d expresses a necessary action in the future or a condition.", "type": "describer"}, {"content": "\u201cHave got to\u201d has irregular forms in the past, present and future.", "type": "text"}, {"content": "<ul><li>Present - <span class=\"italic\">I've got to save money.</span></li><li>Past - <span class=\"italic\">I had to live on a tight budget.</span></li><li>Future - <span class=\"italic\">I will have to watch my spending habits.</span></li>", "type": "text"}, {"content": "\"ve gotta\" is an informal contraction for \"ve got to\" or \"have got to\".<br/> You use it when you are talking to your friends.", "type": "text"}, {"content": " Examples: <br/>  <span class=\"italic\">She'<span class=\"strong\">s gotta</span> find a new hobby.<br/> I'<span class=\"strong\">ve gotta</span> have caffeine.<br/> I'<span class=\"strong\">ve</span> really <span class=\"strong\">gotta</span> cut down on my coffee.<br/> He'<span class=\"strong\">s gotta</span> eat more vegetables.</span>", "type": "text"}, {"content": "\u201cGoing to have to\u201d also expresses a necessary action in the future.", "type": "text"}, {"content": "<ul><li><span class=\"italic\">I'm going have to cut down on my coffee.</span></li><li><span class=\"italic\">I'm going to have to invest in a small machine. </span></li></ul>", "type": "text"}, {"content": "It's also used as a result in a conditional phrase.", "type": "text"}, {"content": "<ul><li><span class=\"italic\">If I'm on a tight budget, I'm going to have to cook more often at home. </span></li></ul>", "type": "text"}]}, {"type": "target_word_describer", "contents": [{"content": " These are words you use to talk about eating habits.", "type": "text"}]}, {"type": "target_word", "contents": [{"content": "occasionally", "type": "name"}, {"content": "sometimes or on certain occasions", "type": "definition"}, {"content": "(adverb)", "type": "part_speech"}, {"content": "Example: I used to drink coffee only occasionally.", "type": "example"}, {"content": "engenn6le03ob09aud01", "type": "audio"}]}, {"type": "target_word", "contents": [{"content": "to eat out", "type": "name"}, {"content": "to eat away from home at a restaurant ", "type": "definition"}, {"content": "(verb)", "type": "part_speech"}, {"content": "Example: I only eat out once on the weekend.", "type": "example"}, {"content": "engenn6le03ob09aud02", "type": "audio"}]}, {"type": "target_word", "contents": [{"content": "to fill up", "type": "name"}, {"content": "a phrasal verb to mean fill up a cup, a container or the car's gasoline tank", "type": "definition"}, {"content": "(verb)", "type": "part_speech"}, {"content": "Example: Oh, I want more coffee. Fill it up please.", "type": "example"}, {"content": "engenn6le03ob09aud03", "type": "audio"}]}, {"type": "target_word", "contents": [{"content": "to cut down", "type": "name"}, {"content": "to reduce in amount ", "type": "definition"}, {"content": "(verb)", "type": "part_speech"}, {"content": "Example: I've really gotta cut down on my coffee consumption.", "type": "example"}, {"content": "engenn6le03ob09aud04", "type": "audio"}]}, {"type": "target_word", "contents": [{"content": "to go through ", "type": "name"}, {"content": "to use or consume a certain amount ", "type": "definition"}, {"content": "(verb)", "type": "part_speech"}, {"content": "Example: I would go through about a pound of coffee a month.", "type": "example"}, {"content": "engenn6le03ob09aud05", "type": "audio"}]}, {"type": "target_word", "contents": [{"content": "to invest", "type": "name"}, {"content": "to spend money, time or effort on something that would be valuable for the future", "type": "definition"}, {"content": "(verb)", "type": "part_speech"}, {"content": "Example: I'm going to have to invest in a small cappuccino machine.", "type": "example"}, {"content": "engenn6le03ob09aud06", "type": "audio"}]}, {"type": "target_word", "contents": [{"content": "to snack", "type": "name"}, {"content": "to eat a small amount between meals", "type": "definition"}, {"content": "(verb)", "type": "part_speech"}, {"content": "Example: You can try snacking on some carrot sticks and biscuits. ", "type": "example"}, {"content": "engenn6le03ob09aud07", "type": "audio"}]}, {"type": "takeaway_extension", "contents": [{"content": "Think of 3 past eating or drinking habits you used to have. ", "type": "text"}, {"content": "Write a sentence about each of them. Use \u201cused to\u201d and \u201cwould\u201d.", "type": "text"}, {"content": "Think of 3 current habits you would like to change. Write what you <span class=\"italic\">have got to do to</span> change.", "type": "text"}, {"content": "Listen to your partner's ideas and then share yours.", "type": "text"}]}, {"type": "takeaway_assessment", "contents": [{"content": "I express past eating habits in writing.", "type": "text"}, {"content": "I express future necessity in my life in writing.", "type": "text"}, {"content": "I listen to my partner's ideas.", "type": "text"}, {"content": "I share my ideas verbally with my partner.", "type": "text"}]}]}