edback": [{"content": "", "type": "text"}, {"content": "", "type": "text"}]}, "type": "feedback"}, {"type": "learning_skills", "contents": [{"content": "Listening", "type": "skill"}, {"content": "Reading", "type": "skill"}, {"content": "Speaking", "type": "skill"}]}, {"type": "post_instructions", "contents": [{"content": "Instructions: <span class=\"bullet\">\nListen to the audio. </span> <span class=\"bullet\">\nRecord yourself saying the sentences aloud.</span>\n <span class=\"bullet\">\nCompare yourself to the audio.</span>", "type": "text"}]}], "id": 11, "stimuli_ids": []}], "stimuli": [{"template_override": 1, "_data": [], "type": "welcome", "contents": [{}], "id": 0}, {"template_override": 1, "_data": [], "type": "audio", "title": "", "contents": [{"type": "slideshow", "value": {"audiosrc": "engenn6le03ob04re2aud01", "coverimg": "engenn6le03ob04re2img10.jpg", "images": [{"image": "engenn6le03ob04re2img10.jpg", "text": "", "id": 0, "time": "0"}, {"image": "engenn6le03ob04re2img10.jpg", "text": "<span class =\"strong\">Sally</span>: Hey Vanessa. What have you been up to?<br />\n<span class =\"strong\">Vanessa</span>: Not much, I'm just at the supermarket grabbing a loaf of fresh bread, a carton of eggs and some flour to make pancakes. I'm having a leisurely Sunday breakfast. You?<br />\n<span class =\"strong\">Sally</span>: Oh, Linda and I went to that burger joint on First and Bayview last night. Then we went to a late show.", "id": 1, "time": "100"}, {"image": "engenn6le03ob04re2img01.jpg", "text": "<span class =\"strong\">Vanessa</span>: Oh that greasy diner? Sally ... you have to think about what you are consuming. <br />\n<span class =\"strong\">Sally</span>: Their fries are delicious. I topped off my meal with an enormous chocolate sundae - my favorite flavor.<br />\n<span class =\"strong\">Vanessa</span>: You're going to have to stop eating so much garbage.<br />\n<span class =\"strong\">Sally</span>: Hey, I'm young \u2026 and I exercise. I burn off those extra calories.", "id": 2, "time": "19500"}, {"image": "engenn6le03ob04re2img10.jpg", "text": "<span class =\"strong\">Vanessa</span>: True.  You've got to stop by the restaurant sometime. I'll get the chef to whip up a few healthy appetizers for you.<br />\n<span class =\"strong\">Sally</span>: I've got a little bit of time next week. By the way, have you heard from your old flame?<br />\n<span class =\"strong\">Vanessa</span>: Ahhhh no. Gotta fly! See ya.", "id": 3, "time": "42500"}]}}], "id": 1}], "type": "scholar", "id": 0, "_data": [{"type": "lab_options", "contents": [{"content": true, "type": "has_nav"}, {"content": true, "type": "has_exercise_controls"}]}]}], "_data": [{"type": "metadata", "contents": [{"content": "Dinner for Four", "type": "lesson_name"}, {"content": "Would You Like Some More?", "type": "unit_name"}, {"content": 4, "type": "position"}, {"content": "scholar > Looking to the Stars > Indira Gandhi", "type": "origin"}, {"content": 3, "type": "lesson"}, {"content": "B1.1", "type": "level"}]}, {"type": "achievment_test", "contents": [{"content": "false", "type": "test"}]}, {"type": "objectives", "contents": [{"content": "Identify and describe personal and regional eating habits and cooking in  a range of communicative situations.", "type": "primary"}, {"content": "Understands important and some specific information and aspects of attitude and intention using a range of appropriate language, in written or spoken documents or presentations.", "type": "secondary_1"}, {"content": "Understands important and some specific information and aspects of attitude and intention using a range of appropriate language, in written or spoken documents or presentations.", "type": "secondary_2"}, {"content": "Understands important and some specific information and aspects of attitude and intention using a range of appropriate language, in written or spoken documents or presentations.", "type": "secondary_3"}, {"content": "Understands important and some specific information and aspects of attitude and intention using a range of appropriate language, in written or spoken documents or presentations.", "type": "secondary_4"}, {"content": "Understands important and some specific information and aspects of attitude and intention using a range of appropriate language, in written or spoken documents or presentations.", "type": "secondary_5"}, {"content": "Understands important and some specific information and aspects of attitude and intention using a range of appropriate language, in written or spoken documents or presentations.", "type": "secondary_6"}, {"content": "Understands important and some specific information and aspects of attitude and intention using a range of appropriate language, in written or spoken documents or presentations.", "type": "secondary_7"}, {"content": "Understands important and some specific information and aspects of attitude and intention using a range of appropriate language, in written or spoken documents or presentations.", "type": "secondary_8"}]}, {"content": "engenn6le03ob04re1img01.jpg", "type": "background_image"}, {"type": "learning_points", "contents": [{"content": " L Family Consonants", "type": "heading"}, {"content": " <span class=\"strong\">Consonant</span> clusters like <span class = \"italic\">fl </span>can occur at the beginning of a word in English.<br />  Practice blending the sound from one consonant sound into the next without adding a vowel sound in between.", "type": "describer"}, {"content": " Look and say the words with the <span class = \"italic\">fl</span> sound aloud.", "type": "text"}, {"content": "{\"rows\":2,\"columns\":4,\"cells\":[\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\" flute\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"flame\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"flag\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\" flashlight\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"flask\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"flower\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"flour\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"Florida\\\"}\"],\"styles\":\" intro_table_border\"}", "type": "table"}]}, {"type": "learning_points", "contents": [{"content": " Stressing New Information", "type": "heading"}, {"content": "Sentence stress gives English its <span class =\"strong\">rhythm</span>  or \"beat\". <br />  Word stress is emphasis on <span class =\"strong\">one syllable</span> within a <span class =\"strong\">word</span>.<br />   Sentence stress is emphasis on <span class =\"strong\">certain words</span> within a <span class =\"strong\">sentence</span>.", "type": "describer"}, {"content": "  Most sentences have two basic types of words:<br />  <span class =\"strong\">Content Words</span><br /> &bull;  Content words are the important or key words of a sentence. They provide the meaning of the sentence. <br />  <span class =\"strong\">Structure Words</span><br /> &bull;  Structure words are not important words. They are small words that you use to make the sentence correct. <br /> <span class =\"strong\">New Information Stress</span><br /> &bull; When asked a question, the requested information is stressed.<br />", "type": "text"}, {"content": "  Where are you from? - I come from <span class =\"strong\">Cambridge</span>, in the USA.", "type": "example"}, {"content": " What do you want to do? - I want to go to the <span class =\"strong\">movies</span>.", "type": "example"}, {"content": " When does the movie begin? - The movie begins at <span class =\"strong\">eight o'clock.", "type": "example"}]}, {"type": "target_word", "contents": [{"content": "to grab", "type": "name"}, {"content": "to quickly take and hold", "type": "definition"}, {"content": "(verb)", "type": "part_speech"}, {"content": "Example: I'm just at the supermarket grabbing a loaf of fresh bread.", "type": "example"}, {"content": "engenn6le03ob04aud01", "type": "audio"}]}, {"type": "target_word_describer", "contents": [{"content": " These are words you use in a conversation with a friend.", "type": "text"}]}, {"type": "target_word", "contents": [{"content": "leisurely", "type": "name"}, {"content": " slow and relaxed", "type": "definition"}, {"content": "(adjective)", "type": "part_speech"}, {"content": "Example: I'm having a leisurely Sunday breakfast. ", "type": "example"}, {"content": "engenn6le03ob04aud02", "type": "audio"}]}, {"type": "target_word", "contents": [{"content": "late show", "type": "name"}, {"content": "a movie that starts late at night", "type": "definition"}, {"content": "(noun)", "type": "part_speech"}, {"content": "Example: Then we went to a late show.", "type": "example"}, {"content": "engenn6le03ob04aud03", "type": "audio"}]}, {"type": "target_word", "contents": [{"content": "greasy", "type": "name"}, {"content": "containing or cooked with a large amount of fat", "type": "definition"}, {"content": "(adjective)", "type": "part_speech"}, {"content": "Example: We are going to that greasy diner again?", "type": "example"}, {"content": "engenn6le03ob04aud04", "type": "audio"}]}, {"type": "target_word", "contents": [{"content": " to consume", "type": "name"}, {"content": "to eat or drink", "type": "definition"}, {"content": "(verb)", "type": "part_speech"}, {"content": "Example: You have to think about all the fat you are consuming.", "type": "example"}, {"content": "engenn6le03ob04aud05", "type": "audio"}]}, {"type": "target_word", "contents": [{"content": "to top off", "type": "name"}, {"content": "to finish or complete", "type": "definition"}, {"content": "(verb)", "type": "part_speech"}, {"content": "Example: I topped off my meal with an enormous chocolate sundae.", "type": "example"}, {"content": "engenn6le03ob04aud06", "type": "audio"}]}, {"type": "target_word", "contents": [{"content": "garbage", "type": "name"}, {"content": "unhealthy food", "type": "definition"}, {"content": "(noun)", "type": "part_speech"}, {"content": "Example: You're going to have to stop eating so much garbage.", "type": "example"}, {"content": "engenn6le03ob04aud07", "type": "audio"}]}, {"type": "target_word", "contents": [{"content": "an old flame", "type": "name"}, {"content": "an old boyfriend or girlfriend", "type": "definition"}, {"content": "(expression)", "type": "part_speech"}, {"content": "Example: Have you heard from your old flame?", "type": "example"}, {"content": "engenn6le03ob04aud08", "type": "audio"}]}, {"type": "target_word", "contents": [{"content": "gotta fly", "type": "name"}, {"content": "need to go", "type": "definition"}, {"content": "(expression)", "type": "part_speech"}, {"content": "Example: I've gotta fly.", "type": "example"}, {"content": "engenn6le03ob04aud09", "type": "audio"}]}, {"type": "takeaway_extension", "contents": [{"content": "Write a 10-12 line dialogue between yourself and a friend about food and daily activities.", "type": "text"}, {"content": "Include three words with the fl sound in the dialogue.", "type": "text"}, {"content": "Use the words <span class=\"strong\">got to</span> and <span class=\"strong\">have to</span>.", "type": "text"}, {"content": "Read the dialogue with a partner.", "type": "text"}]}, {"type": "takeaway_assessment", "contents": [{"content": "I write a dialogue about food and daily activities.", "type": "text"}, {"content": "I include words with the fl sound in my dialogue.", "type": "text"}, {"content": "I use the words got to and have to.", "type": "text"}, {"content": "I read the dialogue about food and activities with a partner.", "type": "text"}]}]}